#!/command/with-contenv bashio
# ==============================================================================
# Home Assistant Ghostty Add-on
# Take down the S6 supervision tree when Ghostty fails
# ==============================================================================
if [[ "${1}" -ne 0 ]] && [[ "${1}" -ne 256 ]]; then
  bashio::log.warning "Ghostty crashed, halting add-on"
  /run/s6/basedir/bin/halt
fi

bashio::log.info "Ghostty stopped, restarting..."
