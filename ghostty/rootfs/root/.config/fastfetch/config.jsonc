{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/ha-logo.txt",
    "color": { "1": "cyan" },
    "padding": {
      "top": 1,
      "right": 4,
      "left": 2
    }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[36m  Home Assistant\u001b[0m │ \u001b[90mGhostty Terminal\u001b[0m"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌────────────────────System Info─────────────────────┐"
    },
    {
      "type": "host",
      "key": "│  Host",
      "keyColor": "cyan"
    },
    {
      "type": "os",
      "key": "│  OS",
      "keyColor": "cyan"
    },
    {
      "type": "kernel",
      "key": "│  Kernel",
      "keyColor": "cyan"
    },
    {
      "type": "uptime",
      "key": "│ 󰅐 Uptime",
      "keyColor": "cyan"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Hardware──────────────────────┐"
    },
    {
      "type": "cpu",
      "key": "│  CPU",
      "showPeCoreCount": true,
      "keyColor": "green"
    },
    {
      "type": "memory",
      "key": "│  Memory",
      "keyColor": "green"
    },
    {
      "type": "disk",
      "key": "│ 󰋊 Disk",
      "keyColor": "green"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌───────────────────────Network──────────────────────┐"
    },
    {
      "type": "localip",
      "key": "│ 󰈀 IP",
      "keyColor": "blue",
      "showIpv4": true,
      "showIpv6": false
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    }
  ]
}

