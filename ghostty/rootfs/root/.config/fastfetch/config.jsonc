{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/ha-logo.txt",
    "color": { "1": "cyan" },
    "padding": {
      "top": 1,
      "right": 4,
      "left": 2
    }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[36m  Home Assistant\u001b[0m │ \u001b[90mGhostty Terminal\u001b[0m"
    },
    "break",
    {
      "type": "command",
      "key": "   Addon",
      "keyColor": "cyan",
      "text": "ha addons info self --raw-json 2>/dev/null | jq -r '.data.version // empty' || echo 'N/A'"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌────────────────────System Info─────────────────────┐"
    },
    {
      "type": "command",
      "key": "│  Hostname",
      "keyColor": "cyan",
      "text": "ha host info --raw-json 2>/dev/null | jq -r '.data.hostname // empty' || echo 'N/A'"
    },
    {
      "type": "command",
      "key": "│  OS",
      "keyColor": "cyan",
      "text": "ha host info --raw-json 2>/dev/null | jq -r '.data.operating_system // empty' || echo 'N/A'"
    },
    {
      "type": "command",
      "key": "│  Kernel",
      "keyColor": "cyan",
      "text": "ha host info --raw-json 2>/dev/null | jq -r '.data.kernel // empty' || echo 'N/A'"
    },
    {
      "type": "command",
      "key": "│  Core",
      "keyColor": "cyan",
      "text": "ha core info --raw-json 2>/dev/null | jq -r '.data.version // empty' || echo 'N/A'"
    },
    {
      "type": "command",
      "key": "│ 󰅐 Uptime",
      "keyColor": "cyan",
      "text": "ha host info --raw-json 2>/dev/null | jq -r '.data.boot_timestamp // empty' | xargs -I {} date -d {} '+%s' 2>/dev/null | xargs -I {} bash -c 'echo $(( ($(date +%s) - {}) / 86400 ))d $(( (($(date +%s) - {}) % 86400) / 3600 ))h $(( (($(date +%s) - {}) % 3600) / 60 ))m' || echo 'N/A'"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Hardware──────────────────────┐"
    },
    {
      "type": "command",
      "key": "│  CPU",
      "keyColor": "green",
      "text": "ha host info --raw-json 2>/dev/null | jq -r '.data.cpe // empty' | sed 's/.*://' || echo 'N/A'"
    },
    {
      "type": "command",
      "key": "│  Memory",
      "keyColor": "green",
      "text": "ha host info --raw-json 2>/dev/null | jq -r '(.data.memory_total // 0) / 1073741824 | floor | tostring + \" GB\"' || echo 'N/A'"
    },
    {
      "type": "command",
      "key": "│ 󰋊 Disk",
      "keyColor": "green",
      "text": "ha host info --raw-json 2>/dev/null | jq -r '(.data.disk_total // 0) / 1073741824 | floor | tostring + \" GB total, \" + ((.data.disk_used // 0) / 1073741824 | floor | tostring) + \" GB used\"' || echo 'N/A'"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌───────────────────────Network──────────────────────┐"
    },
    {
      "type": "command",
      "key": "│ 󰈀 IP",
      "keyColor": "blue",
      "text": "ha network info --raw-json 2>/dev/null | jq -r '.data.interfaces[0].ipv4.address[0] // empty' | cut -d'/' -f1 || echo 'N/A'"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    }
  ]
}
