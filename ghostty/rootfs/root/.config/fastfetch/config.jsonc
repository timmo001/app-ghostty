{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/ha-logo.txt",
    "color": { "1": "cyan" },
    "padding": {
      "top": 1,
      "right": 4,
      "left": 2
    }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[36m  Home Assistant\u001b[0m │ \u001b[90mGhostty Terminal\u001b[0m"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌────────────────────System Info─────────────────────┐"
    },
    {
      "type": "command",
      "key": "│ 󰟀 Hostname",
      "keyColor": "cyan",
      "text": "ha host info --raw-json 2>/dev/null | jq -r '.data.hostname // empty' || echo 'N/A'"
    },
    {
      "type": "command",
      "key": "│ 󰍹 OS",
      "keyColor": "cyan",
      "text": "ha host info --raw-json 2>/dev/null | jq -r '.data.operating_system // empty' || echo 'N/A'"
    },
    {
      "type": "command",
      "key": "│ 󰌢 Kernel",
      "keyColor": "cyan",
      "text": "ha host info --raw-json 2>/dev/null | jq -r '.data.kernel // empty' || echo 'N/A'"
    },
    {
      "type": "command",
      "key": "│ 󰟰 Core",
      "keyColor": "cyan",
      "text": "ha core info --raw-json 2>/dev/null | jq -r '.data.version // empty' || echo 'N/A'"
    },
    {
      "type": "command",
      "key": "│ 󰅐 Uptime",
      "keyColor": "cyan",
      "text": "ha host info --raw-json 2>/dev/null | jq -r '.data.boot_timestamp // empty' | xargs -I {} date -d {} '+%s' 2>/dev/null | xargs -I {} bash -c 'echo $(( ($(date +%s) - {}) / 86400 ))d $(( (($(date +%s) - {}) % 86400) / 3600 ))h $(( (($(date +%s) - {}) % 3600) / 60 ))m' || echo 'N/A'"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌───────────────Home Assistant Info─────────────────┐"
    },
    {
      "type": "command",
      "key": "│ 󰟰 Supervisor",
      "keyColor": "yellow",
      "text": "ha supervisor info --raw-json 2>/dev/null | jq -r '.data.version // empty' || echo 'N/A'"
    },
    {
      "type": "command",
      "key": "│ 󰍹 HA OS",
      "keyColor": "yellow",
      "text": "ha os info --raw-json 2>/dev/null | jq -r '.data.version // empty' || echo 'N/A'"
    },
    {
      "type": "command",
      "key": "│ 󰏖 Addons",
      "keyColor": "yellow",
      "text": "ha addons --raw-json 2>/dev/null | jq -r '[.data.addons[] | select(.installed == true)] | length' || echo 'N/A'"
    },
    {
      "type": "command",
      "key": "│ 󰄨 State",
      "keyColor": "yellow",
      "text": "ha supervisor info --raw-json 2>/dev/null | jq -r '.data.state // empty' || echo 'N/A'"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Hardware──────────────────────┐"
    },
    {
      "type": "command",
      "key": "│ 󰻠 CPU",
      "keyColor": "green",
      "text": "lscpu 2>/dev/null | grep -m1 '^Model name' | sed 's/^[^:]*: *//' || lscpu 2>/dev/null | grep -m1 '^Architecture' | sed 's/^[^:]*: *//' || grep -m1 'model name' /proc/cpuinfo 2>/dev/null | sed 's/^[^:]*: *//' || echo 'N/A'"
    },
    {
      "type": "command",
      "key": "│ 󰍛 Memory",
      "keyColor": "green",
      "text": "output=$(awk '/MemTotal/ {printf \"%.1f GB\", $2/1024/1024; exit}' /proc/meminfo 2>/dev/null); [ -n \"$output\" ] && echo \"$output\" || echo 'N/A'"
    },
    {
      "type": "command",
      "key": "│ 󰋊 Disk",
      "keyColor": "green",
      "text": "output=$(df -h / 2>/dev/null | awk 'NR==2 {printf \"%s total, %s used\", $2, $3; exit}'); [ -n \"$output\" ] && echo \"$output\" || echo 'N/A'"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌───────────────────────Network──────────────────────┐"
    },
    {
      "type": "command",
      "key": "│ 󰈀 IP",
      "keyColor": "blue",
      "text": "ha network info --raw-json 2>/dev/null | jq -r '.data.interfaces[0].ipv4.address[0] // empty' | cut -d'/' -f1 || echo 'N/A'"
    },
    {
      "type": "command",
      "key": "│ 󰤨 Interface",
      "keyColor": "blue",
      "text": "ha network info --raw-json 2>/dev/null | jq -r '.data.interfaces[0].interface // empty' || echo 'N/A'"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    }
  ]
}
